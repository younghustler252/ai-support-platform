NODE_ENV=development
PORT=4000

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://supportai:change-me@localhost:5433/supportai_dev

CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_PREVIOUS_SECRET=
AUTH_JWT_ISSUER=support-api
AUTH_JWT_AUDIENCE=support-clients
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_DOMAIN=

AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_SESSION_MAX_DAYS=30
AUTH_VERIFY_TTL_HOURS=24
AUTH_RESET_TTL_MINUTES=60
AUTH_REFRESH_GRACE_SECONDS=10
AUTH_MAX_ACTIVE_SESSIONS=10

AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=

# AI replies (optional; without a key conversations hand over to a human)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# Redis (BullMQ jobs). Optional in development: without it emails send in-process and AI replies are requested by the client. Required in production.
REDIS_URL=redis://localhost:6379
